#!/usr/bin/env bash
set -e

echo "==> 1. Creating new directory structure"
mkdir -p src/components/ui src/components/figma src/lib public/icons scripts

echo "==> 2. Moving source files"
for f in src/app/components/*.tsx; do git mv "$f" src/components/; done
for f in src/app/components/ui/*; do git mv "$f" src/components/ui/; done
[ -f src/app/components/figma/ImageWithFallback.tsx ] && git mv src/app/components/figma/ImageWithFallback.tsx src/components/figma/
for f in bristol calorie correlation exercise-calories food-classifier foods goals sai stool-classifier storage types; do
  git mv "src/app/$f.ts" src/lib/
done
git mv src/app/App.tsx src/components/App.tsx

echo "==> 3. Deleting old Vite files"
git rm index.html vite.config.ts src/main.tsx
git rm -r src/app/components src/app 2>/dev/null || true

echo "==> 4. Adding 'use client' to all components"
for f in src/components/*.tsx; do
  grep -q '"use client"' "$f" || { sed -i.bak '1s/^/"use client";\n/' "$f" && rm -f "$f.bak"; }
done

echo "==> 5. Updating import paths in App.tsx"
sed -i.bak 's|from "\./components/|from "./|g;s|from "\./types"|from "@/lib/types"|g;s|from "\./storage"|from "@/lib/storage"|g;s|from "\./sai"|from "@/lib/sai"|g' src/components/App.tsx && rm -f src/components/App.tsx.bak

echo "==> 6. Updating import paths in feature components"
for f in src/components/*.tsx; do
  [ "$f" = "src/components/App.tsx" ] && continue
  sed -i.bak 's|from "\.\./types"|from "@/lib/types"|g;s|from "\.\./storage"|from "@/lib/storage"|g;s|from "\.\./calorie"|from "@/lib/calorie"|g;s|from "\.\./exercise-calories"|from "@/lib/exercise-calories"|g;s|from "\.\./foods"|from "@/lib/foods"|g;s|from "\.\./stool-classifier"|from "@/lib/stool-classifier"|g;s|from "\.\./food-classifier"|from "@/lib/food-classifier"|g;s|from "\.\./goals"|from "@/lib/goals"|g;s|from "\.\./bristol"|from "@/lib/bristol"|g;s|from "\.\./correlation"|from "@/lib/correlation"|g;s|from "\.\./sai"|from "@/lib/sai"|g' "$f" && rm -f "$f.bak"
done

echo "==> 7. Writing config files"
cat > package.json << 'PKGJSON'
{
