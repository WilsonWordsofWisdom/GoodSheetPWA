echo "==> 10. Generating placeholder icons"
node -e "
const {writeFileSync,mkdirSync}=require('fs'),zlib=require('zlib');
function u32(n){const b=Buffer.alloc(4);b.writeUInt32BE(n,0);return b;}
function crc32(buf){let c=0xffffffff,t=new Uint32Array(256);for(let n=0;n<256;n++){let x=n;for(let k=0;k<8;k++)x=x&1?0xedb88320^(x>>>1):x>>>1;t[n]=x;}for(const b of buf)c=(c>>>8)^t[(c^b)&0xff];return(c^0xffffffff)>>>0;}
function chunk(type,data){const tb=Buffer.from(type);const ci=Buffer.concat([tb,data]);return Buffer.concat([u32(data.length),tb,data,u32(crc32(ci))]);}
function png(sz,r,g,b){const sig=Buffer.from([137,80,78,71,13,10,26,10]);const ih=Buffer.alloc(13);ih.writeUInt32BE(sz,0);ih.writeUInt32BE(sz,4);ih[8]=8;ih[9]=2;const rs=1+sz*3,raw=Buffer.alloc(sz*rs);for(let y=0;y<sz;y++){const o=y*rs;raw[o]=0;for(let x=0;x<sz;x++){raw[o+1+x*3]=r;raw[o+2+x*3]=g;raw[o+3+x*3]=b;}}return Buffer.concat([sig,chunk('IHDR',ih),chunk('IDAT',zlib.deflateSync(raw)),chunk('IEND',Buffer.alloc(0))]);}
mkdirSync('public/icons',{recursive:true});
for(const s of [72,96,128,144,152,192,384,512]){writeFileSync('public/icons/icon-'+s+'x'+s+'.png',png(s,0x42,0x85,0xf4));console.log('✓ '+s+'x'+s);}
writeFileSync('public/icons/apple-touch-icon.png',png(180,0x42,0x85,0xf4));console.log('✓ apple-touch-icon');
"

echo "==> 11. Staging all changes"
git add -A

echo "==> 12. Installing dependencies"
npm install --legacy-peer-deps

echo ""
echo "✅ Done! Now run:"
echo "   git commit -m 'Refactor: migrate from Vite SPA to Next.js 15 PWA'"
echo "   git push -u origin claude/nextjs-pwa-refactor-Cfol4"